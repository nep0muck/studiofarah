---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { variant?: 'primary' | 'secondary' };
const { variant = 'primary', class: className, ...attributes } = Astro.props;
---

<a {...attributes} class:list={[variant === 'primary' ? 'btn-primary' : 'btn-secondary', className]}>
  <slot />
</a>
