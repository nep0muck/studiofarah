---
import { site } from '@data/site';
import StudioLogo from '../ui/StudioLogo.astro';

const currentYear = new Date().getFullYear();
const phoneHref = `tel:${site.phoneDisplay.replace(/[^+\d]/g, '')}`;
---

<footer class="border-t border-line bg-white py-10 text-base text-muted">
  <div class="container">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_auto]">
      <div>
        <a href="/#start" class="inline-flex min-h-12 items-center gap-3 text-brand" aria-label={`${site.name} – zur Startseite`}>
          <StudioLogo class="h-10 w-10" />
          <span class="brand-wordmark text-[1.7rem]">{site.name}</span>
        </a>
        <p class="mt-2">Kosmetik & Wohlbefinden in Bremen-Findorff</p>
      </div>

      <address class="not-italic leading-relaxed">
        {site.address.map((line) => <p>{line}</p>)}
        <a href={phoneHref} class="inline-flex min-h-11 items-center text-ink underline underline-offset-4">{site.phoneDisplay}</a>
      </address>

      <nav class="flex flex-wrap gap-x-6 lg:flex-col lg:gap-0" aria-label="Rechtliche Informationen">
        <a href="/impressum/" class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-brand">Impressum</a>
        <a href="/datenschutz/" class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-brand">Datenschutz</a>
      </nav>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-5">
      <p>© {currentYear} {site.name}</p>
      <a href="/#start" class="inline-flex min-h-11 items-center gap-2 underline underline-offset-4 hover:text-brand">
        Nach oben <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>
