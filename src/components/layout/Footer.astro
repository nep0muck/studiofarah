---
import { site } from '@data/site';
const currentYear = new Date().getFullYear();
---

<footer class="section border-t bg-gray-100">
  <div class="container grid gap-6 md:grid-cols-3">
    <div>
      <p class="font-semibold">{site.name}</p>
      <p class="mt-2 text-sm">{site.description}</p>
    </div>

    <address class="not-italic text-sm">
      {site.address.map((line) => <p>{line}</p>)}
      <p class="mt-2"><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></p>
      <p><a href={`tel:${site.phoneDisplay.replaceAll(' ', '')}`} class="hover:underline">{site.phoneDisplay}</a></p>
    </address>

    <div class="flex flex-col gap-2 text-sm md:items-end">
      <a href="/impressum/" class="hover:underline">Impressum</a>
      <a href="/datenschutz/" class="hover:underline">Datenschutz</a>
      <p class="mt-2">© {currentYear} {site.name}</p>
    </div>
  </div>
</footer>
