---
import { navItems, site } from '@data/site';
---

<header class="sticky top-0 z-50 border-b border-gray-200 shadow-sm shadow-gray-100 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4" aria-label="Hauptnavigation">

    <a
      href="/"
      class="group flex items-center gap-3"
      aria-label={`Zur Startseite von ${site.name}`}
    >
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-pink-200 bg-gradient-to-br from-yellow-50 via-pink-50 to-gray-100 shadow-sm transition group-hover:scale-105">
        <span class="font-serif text-xl font-semibold italic text-pink-600">
          {site.textlogo}
        </span>
      </span>

      <span class="leading-tight">
        <span class="block text-lg font-semibold tracking-wide text-gray-900 md:text-xl">
          {site.name}
        </span>

        <span class="hidden text-xs font-medium uppercase tracking-[0.18em] text-gray-500 sm:block">
          {site.subtitle}
        </span>
      </span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-sm hover:underline">
          {item.label}
        </a>
      ))}
<!--       <a href="/impressum/" class="text-sm hover:underline">Impressum</a>
      <a href="/datenschutz/" class="text-sm hover:underline">Datenschutz</a> -->
    </div>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded border btn-secondary px-3 py-2 text-sm">
        Menü
      </summary>
      <div class="absolute right-0 mt-2 flex w-56 flex-col gap-3 rounded border card-soft bg-white! p-4 shadow">
        {navItems.map((item) => (
          <a href={item.href} class="text-sm hover:underline">
            {item.label}
          </a>
        ))}
<!--         <a href="/impressum/" class="text-sm hover:underline">Impressum</a>
        <a href="/datenschutz/" class="text-sm hover:underline">Datenschutz</a> -->
      </div>
    </details>
  </nav>
</header>
