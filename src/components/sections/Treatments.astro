---
import { treatments, treatmentsIntro } from '@data/site';
const mainTreatments = treatments.slice(0, 3);
const otherTreatments = treatments.slice(3);
---

<section id="behandlungen" class="section" aria-labelledby="behandlungen-title">
  <div class="container">
    <div class="max-w-2xl">
      <p class="eyebrow">Meine Behandlungen</p>
      <h2 id="behandlungen-title" class="section-title mt-3">Pflege, die Ihnen guttut.</h2>
      <p class="mt-5 text-muted">{treatmentsIntro.text}</p>
    </div>
    <div class="mt-10 grid gap-9 md:grid-cols-3 md:gap-7">
      {mainTreatments.map((treatment, index) => (
        <article class="border-t border-line pt-6">
          <p class="font-serif text-3xl text-brand" aria-hidden="true">0{index + 1}</p>
          <a href={treatment.href} class="group block" aria-label={`${treatment.title}: Behandlungen und Preise`}>
            <h3 class="mt-4 text-[1.75rem] group-hover:text-brand-dark">{treatment.title}</h3>
          </a>
          <p class="mt-3 text-muted">{treatment.description}</p>
          <a href={treatment.href} class="text-link mt-3 inline-flex min-h-11 items-center gap-2 text-base font-semibold">
            Behandlungen & Preise <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-line pt-5 text-base">
      <p class="text-muted">Außerdem für Sie da:</p>
      {otherTreatments.map((treatment) => (
        <a class="text-link inline-flex min-h-11 items-center gap-2 font-semibold" href={treatment.href}>
          {treatment.title} <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
