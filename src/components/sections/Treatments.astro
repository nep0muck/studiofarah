---
import { treatments } from '@data/site';
---

<section id="behandlungen" class="scroll-mt-24 border-t">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="max-w-2xl">
      <p class="mb-2 text-sm uppercase tracking-wide">Behandlungen</p>
      <h2 class="text-3xl font-semibold">Leistungen im Überblick</h2>
      <p class="mt-4">
        Die Inhalte sind als Platzhalter angelegt und können direkt in <code>src/data/site.ts</code> angepasst werden.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {treatments.map((treatment) => (
        <article class="rounded border p-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <h3 class="text-xl font-semibold">{treatment.title}</h3>
            <p class="shrink-0 text-sm font-medium">{treatment.price}</p>
          </div>
          <p class="mt-3">{treatment.description}</p>
          <p class="mt-4 text-sm">Dauer: {treatment.duration}</p>
        </article>
      ))}
    </div>
  </div>
</section>
