---
import { treatments, treatmentsIntro } from "../../data/site";
---

<section id="behandlungen" class="section bg-white">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-wide text-pink-500">
        {treatmentsIntro.eyebrow}
      </p>

      <h2 class="mt-3 text-3xl font-semibold leading-tight text-gray-900 md:text-4xl">
        {treatmentsIntro.title}
      </h2>

      <p class="mt-4 text-base leading-relaxed text-gray-700">
        {treatmentsIntro.text}
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {treatments.map((treatment) => (
        <article class="group overflow-hidden rounded-3xl border border-gray-200 bg-yellow-50/40 p-4 shadow-sm transition hover:-translate-y-1 hover:bg-pink-50/50 hover:shadow-md">
          <div class="overflow-hidden rounded-2xl border border-gray-100 bg-gray-100">
            <img
              src={treatment.image.src}
              alt={treatment.image.alt}
              width="960"
              height="720"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>

          <div class="flex h-full flex-col px-2 pb-2 pt-6">
            <h3 class="text-xl font-semibold text-gray-900">
              {treatment.title}
            </h3>

            <p class="mt-3 text-sm leading-relaxed text-gray-700">
              {treatment.description}
            </p>

            <a
              href={treatment.href}
              class="mt-6 btn btn-secondary inline-flex items-center text-sm font-medium text-pink-600 transition group-hover:text-pink-700"
            >
              {treatment.title} ansehen
            </a>

          </div>
        </article>
      ))}
    </div>
  </div>
</section>