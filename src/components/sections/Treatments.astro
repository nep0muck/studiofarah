---
import { treatments, treatmentsIntro } from "../../data/site";
---

<section id="behandlungen" class="section bg-white">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-wide text-pink-500">
        {treatmentsIntro.eyebrow}
      </p>

      <h2 class="mt-3 text-3xl font-semibold leading-tight text-gray-900 md:text-4xl">
        {treatmentsIntro.title}
      </h2>

      <p class="mt-4 text-base leading-relaxed text-gray-700">
        {treatmentsIntro.text}
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {treatments.map((treatment) => (
        <article class="group rounded-3xl border border-gray-200 bg-yellow-50/40 p-6 shadow-sm transition hover:-translate-y-1 hover:bg-pink-50/50 hover:shadow-md">
          <div class="flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-pink-100 text-pink-600">
              <span class="text-xl" aria-hidden="true">✦</span>
            </div>

            <h3 class="text-xl font-semibold text-gray-900">
              {treatment.title}
            </h3>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-700">
              {treatment.description}
            </p>

            <a
              href={treatment.href}
              class="mt-6 inline-flex items-center text-sm font-medium text-pink-600 transition group-hover:text-pink-700"
            >
              Preise ansehen
              <span class="ml-2 transition group-hover:translate-x-1" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>