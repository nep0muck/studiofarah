---
import { priceSections } from "../../data/site";
---

<section id="preise" class="section bg-yellow-50/40">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium uppercase tracking-wide text-pink-500">
        Preisliste
      </p>

      <h2 class="mt-3 text-3xl font-semibold leading-tight text-gray-900 md:text-4xl">
        Behandlungen und Preise
      </h2>

      <p class="mt-4 text-base leading-relaxed text-gray-700">
        Hier finden Sie eine Übersicht meiner Behandlungen. Gerne berate ich Sie
        persönlich, welche Anwendung am besten zu Ihren Wünschen passt.
      </p>
    </div>

    <div class="mt-12 space-y-12">
      {priceSections.map((section) => (
        <div id={section.id} class="scroll-mt-24 rounded-3xl border border-gray-200 bg-white/80 p-5 shadow-sm md:p-8">
          <div class="max-w-3xl">
            <h3 class="text-2xl font-semibold text-gray-900">
              {section.title}
            </h3>

            {section.description && (
              <p class="mt-3 text-base leading-relaxed text-gray-700">
                {section.description}
              </p>
            )}
          </div>

          <div class="mt-6">
            <table class="w-full border-separate border-spacing-0 text-left">
              <thead class="hidden md:table-header-group">
                <tr>
                  <th scope="col" class="border-b border-gray-200 py-4 pr-6 text-sm font-semibold text-gray-900">
                    Behandlung
                  </th>
                  <th scope="col" class="border-b border-gray-200 py-4 pr-6 text-sm font-semibold text-gray-900">
                    Beschreibung
                  </th>
                  <th scope="col" class="border-b border-gray-200 py-4 text-right text-sm font-semibold text-gray-900">
                    Preis
                  </th>
                </tr>
              </thead>

              <tbody class="block space-y-4 md:table-row-group md:space-y-0">
                {section.items.map((item) => (
                  <tr class="block rounded-2xl border border-gray-200 bg-white p-4 md:table-row md:rounded-none md:border-0 md:bg-transparent md:p-0">
                    <th
                      scope="row"
                      class="block pb-2 text-base font-semibold text-gray-900 md:table-cell md:border-b md:border-gray-100 md:py-4 md:pr-6 md:align-top md:text-sm"
                    >
                      {item.title}
                    </th>

                    <td class="block pb-3 text-sm leading-relaxed text-gray-700 md:table-cell md:border-b md:border-gray-100 md:py-4 md:pr-6 md:align-top">
                      {item.description}
                    </td>

                    <td class="block text-right text-base font-semibold text-pink-600 md:table-cell md:border-b md:border-gray-100 md:py-4 md:align-top md:text-sm">
                      {item.price}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-relaxed text-gray-600">
      Alle Preise verstehen sich als Richtwerte. Je nach individuellem Aufwand
      können einzelne Behandlungen leicht abweichen.
    </p>
  </div>
</section>