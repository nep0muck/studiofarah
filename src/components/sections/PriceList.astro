---
import { priceSections, priceListInfo } from '@data/site';
import Button from '../ui/Button.astro';

const priceDate = new Intl.DateTimeFormat('de-DE', {
  dateStyle: 'long', timeZone: 'Europe/Berlin',
}).format(new Date(`${priceListInfo.updatedAt}T12:00:00Z`));
---

<section id="preise" class="section" aria-labelledby="preise-title">
  <div class="container">
    <div class="max-w-2xl">
      <p class="eyebrow">Gut zu wissen</p>
      <h2 id="preise-title" class="section-title mt-3">Behandlungen & Preise</h2>
      <p class="mt-5 text-muted">Hier finden Sie meine Behandlungen auf einen Blick. Wenn Sie unsicher sind, welche Pflege zu Ihnen passt, berate ich Sie gerne persönlich.</p>
      <div class="mt-6">
        <Button href={priceListInfo.pdfPath} variant="secondary" download="Studio-Farah-Preisliste.pdf" type="application/pdf">Preisliste als PDF herunterladen</Button>
        <p class="mt-3 text-base text-muted">Zum Speichern oder Ausdrucken für zu Hause.</p>
      </div>
    </div>
    <nav aria-label="Behandlungskategorien" class="mt-7 flex flex-wrap gap-x-6 gap-y-1 text-base">
      {priceSections.map((section) => <a href={`#${section.id}`} class="text-link inline-flex min-h-11 items-center">{section.title}</a>)}
    </nav>
    <div class="mt-8 border-t border-line">
      {priceSections.map((section) => (
        <article id={section.id} aria-labelledby={`${section.id}-title`} class="grid gap-5 border-b border-line py-9 md:grid-cols-[0.7fr_1.5fr] md:gap-14">
          <h3 id={`${section.id}-title`} class="max-w-xs text-[1.75rem]">{section.title}</h3>
          <dl>
            {section.items.map((item) => (
              <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-5 border-b border-line/70 py-4 first:pt-0 last:border-0 last:pb-0">
                <dt class="font-semibold leading-normal">{item.title}</dt>
                <dd class="text-right font-semibold tabular-nums text-brand-dark">{item.price}</dd>
                {item.description && <dd class="col-span-2 mt-2 max-w-xl text-base leading-relaxed text-muted">{item.description}</dd>}
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
    <p class="mt-6 text-base text-muted">Preisstand: {priceDate}. Alle Preise in Euro.</p>
  </div>
</section>
