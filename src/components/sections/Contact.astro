---
import { site, localBusiness } from '@data/site';
import Button from '../ui/Button.astro';
const phoneHref = `tel:${site.phoneDisplay.replaceAll(' ', '')}`;
---

<section id="kontakt" class="section bg-blush" aria-labelledby="kontakt-title">
  <div class="container grid gap-12 md:grid-cols-2 lg:gap-20">
    <div>
      <p class="eyebrow">Kontakt & Anfahrt</p>
      <h2 id="kontakt-title" class="section-title mt-3">Ich freue mich auf Sie.</h2>
      <p class="mt-5 max-w-md text-muted">Sie möchten einen Termin vereinbaren oder haben eine Frage? Rufen Sie mich gerne an. Gemeinsam finden wir die passende Behandlung für Sie.</p>
      <a href={phoneHref} class="mt-6 inline-flex min-h-12 items-center text-[clamp(1.75rem,3vw,2.5rem)] font-normal leading-tight text-brand-dark underline decoration-brand/30 underline-offset-8">{site.phoneDisplay.replace('+49 ', '0')}</a>
    </div>
    <div class="border-t border-line pt-7 md:border-t-0 md:border-l md:pt-0 md:pl-12 lg:pl-16">
      <h3 class="text-[1.75rem]">Ihr Weg ins Studio</h3>
      <address class="mt-5 not-italic">
        <p class="font-semibold">{site.name}</p>
        {site.address.map((line) => <p>{line}</p>)}
      </address>
      <div class="mt-5">
        <Button href={localBusiness.mapUrl} variant="secondary" target="_blank" rel="noopener noreferrer">
          Route planen <span class="sr-only">(Google Maps, öffnet in einem neuen Tab)</span>
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" /></svg>
        </Button>
      </div>
      <h4 class="mt-7 font-semibold">Öffnungszeiten</h4>
      <div class="mt-2 text-muted">
        {site.openingHours.map((line) => <p>{line}</p>)}
      </div>
      <p class="mt-3 text-base text-muted">Bitte vereinbaren Sie Ihren Termin vorab telefonisch.</p>
    </div>
  </div>
</section>
