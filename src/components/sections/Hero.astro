---
import { site, hero } from '@data/site';
import Button from "../ui/Button.astro";
const heroImage = "/images/hero/studio-farah-hero.png";
const whatsappUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(site.whatsappMessage)}`;
---

<section id="start" class="section relative overflow-hidden">
  <div class="container">
    <div class="relative min-h-[420px] overflow-hidden rounded-3xl border card-soft bg-gray-100 md:min-h-[520px]">
      <img
        src={heroImage}
        alt="Entspannende Kosmetikbehandlung im Studio Farah"
        width="494"
        height="270"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/75 to-white/10"></div>

      <div class="relative z-10 flex min-h-[420px] items-center px-6 py-12 md:min-h-[520px] md:px-12 lg:px-16">
        <div class="max-w-xl">
          <p class="text-sm font-medium uppercase tracking-wide text-pink-500">
            Kosmetikstudio in Findorff
          </p>

          <h1 class="mt-4 text-4xl font-semibold leading-tight text-gray-900 md:text-5xl lg:text-6xl">
            Ihre kleine Auszeit vom Alltag
          </h1>

          <p class="mt-6 max-w-lg text-base leading-relaxed text-gray-700 md:text-lg">
            Willkommen im Studio Farah. Genießen Sie wohltuende Kosmetik,
            pflegende Behandlungen und persönliche Betreuung in ruhiger,
            angenehmer Atmosphäre.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
              href="#kontakt"
            >
              Termin anfragen
            </Button>

            <Button
              href="#preise"
              variant="secondary"
            >
              Preise ansehen
            </Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>