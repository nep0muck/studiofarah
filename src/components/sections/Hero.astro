---
import { site, studioImages } from '@data/site';
import Button from '../ui/Button.astro';
const phoneHref = `tel:${site.phoneDisplay.replaceAll(' ', '')}`;
---

<section id="start" aria-labelledby="start-title" class="bg-blush">
  <div class="container grid items-center gap-10 py-12 md:grid-cols-2 md:gap-12 md:py-16 lg:gap-16 lg:py-20">
    <div class="max-w-xl">
      <p class="eyebrow">Kosmetik & Fußpflege in Bremen-Findorff</p>
      <h1 id="start-title" class="mt-5 text-[clamp(2.65rem,5.3vw,4.5rem)]">
        Ihre kleine<br />
        <span class="italic text-brand">Auszeit vom Alltag.</span>
      </h1>
      <p class="mt-6 max-w-md text-muted">
        Willkommen im Studio Farah. Wohltuende Behandlungen,
        persönliche Beratung und Zeit für Sie – ganz in Ihrer Nähe.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={phoneHref}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m7 3 3 5-3 2c1.4 3 3 4.6 6 6l2-3 5 3c.5.3.7.9.5 1.4-1 3-3.5 3.8-6.3 2.7C8.5 17.8 4.5 13.5 3 8c-.8-2.7.2-4.5 2.5-5.3.5-.2 1.2-.1 1.5.3Z" /></svg>
          Termin vereinbaren
        </Button>
        <Button href="#preise" variant="secondary">Preise ansehen</Button>
      </div>
      <p class="mt-5 text-base text-muted">
        Gerne persönlich am Telefon:
        <a href={phoneHref} class="whitespace-nowrap font-semibold text-brand-dark underline decoration-brand/40 underline-offset-4">{site.phoneDisplay.replace('+49 ', '0')}</a>
      </p>
    </div>
    <figure>
      <img
        {...studioImages.treatmentRoom}
        class="aspect-[5/4] w-full rounded-sm object-cover object-center md:aspect-[1/1] lg:aspect-[5/4]"
        fetchpriority="high" loading="eager" decoding="async"
      />
      <figcaption class="mt-3 text-right text-base italic text-muted">Willkommen in meinem Studio in Findorff.</figcaption>
    </figure>
  </div>
  <div class="border-y border-line bg-white">
    <div class="container flex flex-wrap justify-between gap-x-6 gap-y-2 py-5 text-base text-muted">
      <p>Persönliche Betreuung</p>
      <p>Individuelle Behandlungen</p>
      <p>Mitten in Bremen-Findorff</p>
    </div>
  </div>
</section>
