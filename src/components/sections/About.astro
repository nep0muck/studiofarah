---
import { about, studioImages } from '@data/site';
---

<section id="ueber-mich" class="section bg-blush" aria-labelledby="about-title">
  <div class="container grid items-center gap-10 md:grid-cols-2 lg:gap-20">
    <figure>
      <img {...studioImages.reception} loading="lazy" decoding="async"
        class="aspect-[5/4] w-full rounded-sm object-cover" />
      <figcaption class="mt-3 text-base text-muted">Der Empfangsbereich mit ausgewählten Pflegeprodukten.</figcaption>
    </figure>
    <div>
      <p class="eyebrow">Persönlich für Sie da</p>
      <h2 id="about-title" class="section-title mt-3">Schön, dass Sie da sind.<br />Ich bin Farah Vakili.</h2>
      <p class="mt-6">{about.intro}</p>
      <p class="mt-4 text-muted">{about.paragraphs[1]}</p>
      <p class="mt-5 border-l-2 border-brand/40 pl-5 text-base text-muted">{about.certification}<br />Fortbildungen in {about.qualifications.join(', ')}.</p>
      <p class="signature mt-7 text-3xl italic text-brand">{about.signature}</p>
    </div>
  </div>
</section>
